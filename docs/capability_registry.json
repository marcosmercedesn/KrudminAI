{
  "schema_version": 1,
  "engine": "KrudminAI",
  "release": "0.1.0.pre.1",
  "capabilities": [
    {
      "name": "resource_query_pipeline",
      "status": "implemented",
      "guarantees": [
        "authenticated actor required",
        "tenant scope before policy scope",
        "whitelisted filters and sort fields",
        "bounded pagination"
      ]
    },
    {
      "name": "crud_mutation_pipeline",
      "status": "implemented",
      "operations": ["create", "update", "destroy"],
      "guarantees": [
        "explicit action authorization",
        "record tenant access check",
        "audit event required after successful persistence",
        "normalized HTML, JSON, and Turbo Stream responses"
      ]
    },
    {
      "name": "hotwire_ui_foundations",
      "status": "implemented",
      "guarantees": [
        "no jQuery runtime dependency",
        "light, dark, and system theme modes",
        "accessible filter, table, and form primitives",
        "visible focus and reduced-motion support"
      ]
    },
    {
      "name": "generator_contracts",
      "status": "implemented",
      "generators": ["install", "resource", "docs-sync"],
      "guarantees": [
        "idempotent generated files and routes",
        "documentation-only sync mode",
        "authenticated and deny-by-default resource scaffolds"
      ]
    }
  ],
  "providers": {},
  "feature_flags": {},
  "compatibility": {
    "rails": ">= 8.1, < 10.0",
    "ruby": ">= 3.3"
  }
}