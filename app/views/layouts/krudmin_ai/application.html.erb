<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "KrudminAI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "krudmin_ai/application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <div class="krudmin-ai-shell">
      <aside class="krudmin-ai-sidebar">
        <%= link_to "KrudminAI", collection_path, class: "krudmin-ai-brand" %>
        <%= render "krudmin_ai/ui/navigation", items: navigation_items %>
      </aside>
      <main class="krudmin-ai-admin">
        <div id="krudmin-ai-flash">
          <% if flash[:notice] %><p class="krudmin-ai-notice" role="status"><%= flash[:notice] %></p><% end %>
          <% if flash[:alert] %><p class="krudmin-ai-alert" role="alert"><%= flash[:alert] %></p><% end %>
        </div>
        <%= yield %>
      </main>
    </div>
  </body>
</html>