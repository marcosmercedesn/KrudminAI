<section class="krudmin-ai-resource-show">
  <% visible_fields = readable_fields(resource.show) %>
  <% title = visible_fields.lazy.map { |field| resource.field_adapter(field).show_value(model) }.find(&:present?) || resource_label %>
  <div class="krudmin-ai-resource-heading">
    <div>
      <p class="krudmin-ai-resource-eyebrow"><%= resource_label %></p>
      <h1><%= title %></h1>
    </div>
    <div class="krudmin-ai-resource-actions">
      <% if authorized_action?(:update) %><%= link_to edit_resource_path, class: "krudmin-ai-button krudmin-ai-button--edit" do %><%= krudmin_ai_icon(:pencil, class: "krudmin-ai-button__icon") %><span><%= t("krudmin_ai.edit", resource: resource_label) %></span><% end %><% end %>
      <% resource_actions.select { |action| %i[record both].include?(action.placement) }.each do |action| %><%= button_to resource_action_path(model, action.name), method: action.method, class: "krudmin-ai-button#{action.variant == :default ? "" : " krudmin-ai-button--#{action.variant}"}", data: (action.confirmation ? { turbo_confirm: action.confirmation } : {}) do %><%= krudmin_ai_icon(action.icon, class: "krudmin-ai-button__icon") %><span><%= action.label %></span><% end %><% end %>
      <% if authorized_action?(:destroy) %><%= button_to resource_path, method: :delete, class: "krudmin-ai-button krudmin-ai-button--danger krudmin-ai-icon-button", aria: { label: t("krudmin_ai.delete", resource: resource_label) }, title: t("krudmin_ai.delete", resource: resource_label) do %><%= krudmin_ai_icon(:trash_2) %><% end %><% end %>
    </div>
  </div>
  <%= render "krudmin_ai/ui/record_details", resource: resource, record: model, fields: visible_fields %>
  <%= render "krudmin_ai/ui/relationship_details", resource: resource %>
</section>