<fieldset class="krudmin-ai-nested-fields" data-controller="krudmin-ai-nested-fields" data-krudmin-ai-nested-fields-maximum-value="<%= relationship.maximum %>">
  <legend><%= relationship.label %></legend>
  <div data-krudmin-ai-nested-fields-target="rows">
    <%= form.fields_for relationship.name do |child_form| %>
      <%= render "krudmin_ai/resources/nested_row", form: child_form, relationship: relationship %>
    <% end %>
  </div>

  <template data-krudmin-ai-nested-fields-target="template"><%= form.fields_for relationship.name, model.public_send(relationship.name).build, child_index: "NEW_RECORD" do |child_form| %><%= render "krudmin_ai/resources/nested_row", form: child_form, relationship: relationship %><% end %></template>
  <button class="krudmin-ai-button" type="button" data-krudmin-ai-nested-fields-target="addButton" data-action="krudmin-ai-nested-fields#add">Add <%= relationship.label.singularize %></button>
</fieldset>