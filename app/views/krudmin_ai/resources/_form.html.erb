<section class="krudmin-ai-form-shell" aria-label="<%= model.persisted? ? t("krudmin_ai.edit", resource: resource_label) : t("krudmin_ai.new", resource: resource_label) %>">
  <%= form_with model: model, url: model.persisted? ? resource_path(model) : collection_path, class: "krudmin-ai-form-grid", data: { controller: "krudmin-ai-form-validation" } do |form| %>
    <section class="validation-summary krudmin-ai-validation-summary" role="alert" aria-labelledby="validation-summary-title" data-krudmin-ai-form-validation-target="summary" <%= "hidden" unless model.errors.any? %>>
      <h2 id="validation-summary-title"><%= t("krudmin_ai.validation_error", resource: resource_label.capitalize) %></h2>
      <ul data-krudmin-ai-form-validation-target="summaryList">
        <% model.errors.each do |error| %>
          <li>
            <% if resource.form.include?(error.attribute) && field_readable?(error.attribute) %>
              <a href="#<%= form.field_id(error.attribute) %>"><%= model.errors.full_message(error.attribute, error.message) %></a>
            <% else %>
              <%= model.errors.full_message(error.attribute, error.message) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <% rendered_relationships = [] %>
    <% sections = resource.form_sections.values %>
    <% sections = [{ label: resource_label.capitalize, fields: resource.form }] if sections.empty? %>
    <% assigned_fields = sections.flat_map { |section| section.fetch(:fields) } %>
    <% remaining_fields = resource.form - assigned_fields %>
    <% sections << { label: t("krudmin_ai.additional_details"), fields: remaining_fields, columns: :one } if remaining_fields.any? %>
    <% sections.each do |section| %>
      <% section_fields = section.fetch(:fields) %>
      <% if section_fields.length == 1 && (rel = resource.relationships[section_fields.first.to_sym]) %>
        <% rendered_relationships << rel.name %>
        <%= render rel.singular? ? "krudmin_ai/resources/has_one" : "krudmin_ai/resources/has_many", form: form, relationship: rel %>
      <% else %>
        <fieldset class="krudmin-ai-form-section krudmin-ai-form-section--<%= section.fetch(:columns, :one) %>">
          <% if section[:label] %><legend><%= section[:label] %></legend><% end %>
          <% section_fields.each do |field| %>
            <% if (rel = resource.relationships[field.to_sym]) %>
              <% rendered_relationships << rel.name %>
              <%= render rel.singular? ? "krudmin_ai/resources/has_one" : "krudmin_ai/resources/has_many", form: form, relationship: rel %>
            <% elsif field_readable?(field) %>
              <% writable = field_writable?(field) %>
              <%= render "krudmin_ai/ui/field", form: form, field: field, adapter: resource.field_adapter(field), writable: writable, rules: krudmin_ai_validation_rules(field), errors: model.errors.full_messages_for(field) %>
            <% end %>
          <% end %>
        </fieldset>
      <% end %>
    <% end %>

    <% (resource.relationships.values.reject { |r| rendered_relationships.include?(r.name) }).each do |relationship| %>
      <%= render relationship.singular? ? "krudmin_ai/resources/has_one" : "krudmin_ai/resources/has_many", form: form, relationship: relationship %>
    <% end %>

    <div class="krudmin-ai-form-actions">
      <%= link_to model.persisted? ? resource_path(model) : collection_path, class: "krudmin-ai-button" do %><%= krudmin_ai_icon(:x, class: "krudmin-ai-button__icon") %><span><%= t("krudmin_ai.cancel") %></span><% end %>
      <%= form.button class: "krudmin-ai-button krudmin-ai-button--save" do %><%= krudmin_ai_icon(:save, class: "krudmin-ai-button__icon") %><span><%= t("krudmin_ai.save", resource: resource_label) %></span><% end %>
    </div>
  <% end %>
</section>