.krudmin-ai-table-wrap
  %table.krudmin-ai-table
    %thead
      %tr
        - columns.each do |column|
          %th{ scope: "col" }= column.fetch(:label)
    %tbody
      - records.each do |record|
        %tr
          - columns.each do |column|
            %td= column.fetch(:value).call(record)