<nav class="krudmin-ai-navigation" aria-label="<%= t("krudmin_ai.main_navigation") %>">
  <% items.each do |item| %>
    <%= link_to item.path_for(self), class: ["krudmin-ai-navigation__item", ("is-active" if item.active?(self))].compact.join(" ") do %>
      <%= krudmin_ai_icon(item.icon, class: "krudmin-ai-navigation__icon") %>
      <span><%= item.display_label %></span>
    <% end %>
  <% end %>
</nav>