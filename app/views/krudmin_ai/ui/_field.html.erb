<% adapter = local_assigns[:adapter] %>
<% rules = local_assigns.fetch(:rules, {}) %>
<% compact = local_assigns.fetch(:compact, false) %>
<% remote = adapter.is_a?(KrudminAI::Fields::RemoteBelongsTo) %>
<% access_note_id = form.field_id(field, "access-note") %>
<% error_id = form.field_id(field, "error") %>
<% lookup_id = form.field_id(field, "lookup") %>
<% described_by = [ (access_note_id unless writable), error_id ].compact.join(" ") %>
<% label_options = {} %>
<% label_options[:class] = "krudmin-ai-sr-only" if compact %>
<% label_options[:for] = lookup_id if remote %>
<div class="krudmin-ai-field<%= " is-invalid" if errors.any? %>" data-krudmin-ai-validation-field="<%= field %>"<% if rules.any? %> data-krudmin-ai-validation-rules="<%= rules.to_json %>"<% end %>>
  <%= form.label field, **label_options %>
  <% if adapter.is_a?(KrudminAI::Fields::Computed) %>
    <output aria-describedby="<%= access_note_id %>"><%= t("krudmin_ai.computed_on_save") %></output>
  <% elsif remote %>
    <div data-controller="krudmin-ai-remote-belongs-to" data-krudmin-ai-remote-belongs-to-url-value="<%= remote_lookup_field_path(field) %>" data-krudmin-ai-remote-belongs-to-minimum-value="<%= adapter.minimum_query_length %>">
      <%= form.hidden_field field, data: { krudmin_ai_remote_belongs_to_target: "value", krudmin_ai_validation_control: "" } %>
      <input type="search" id="<%= lookup_id %>" class="krudmin-ai-input" role="combobox" autocomplete="off" value="<%= adapter.selected_label(form.object, krudmin_ai_access_context) %>" aria-autocomplete="list" aria-expanded="false" aria-controls="<%= field %>-lookup-results" aria-invalid="<%= errors.any? %>" aria-describedby="<%= described_by %>" data-krudmin-ai-remote-belongs-to-target="input" data-krudmin-ai-validation-focus="" data-action="input->krudmin-ai-remote-belongs-to#search keydown->krudmin-ai-remote-belongs-to#keydown" <%= "disabled" unless writable %>>
      <div id="<%= field %>-lookup-results" role="listbox" hidden data-krudmin-ai-remote-belongs-to-target="listbox"></div>
      <p role="status" aria-live="polite" data-krudmin-ai-remote-belongs-to-target="status"></p>
    </div>
  <% elsif adapter.is_a?(KrudminAI::Fields::BelongsTo) || adapter.is_a?(KrudminAI::Fields::HasManyIds) %>
    <%= adapter.form_control(form, writable: writable, errors: errors, access_note_id: access_note_id, error_id: error_id, rules: rules, context: krudmin_ai_access_context, authorization_provider: krudmin_ai_authorization_provider) %>
  <% elsif adapter %>
    <%= adapter.form_control(form, writable: writable, errors: errors, access_note_id: access_note_id, error_id: error_id, rules: rules) %>
  <% else %>
    <%= form.text_field(field, class: "krudmin-ai-input", disabled: !writable, aria: { invalid: errors.any?, describedby: described_by }) %>
  <% end %>
  <% unless writable %><p id="<%= access_note_id %>" class="krudmin-ai-field-note"><%= t("krudmin_ai.edit_field_denied") %></p><% end %>
  <p id="<%= error_id %>" class="krudmin-ai-field-error" role="alert" data-krudmin-ai-validation-error <%= "hidden" unless errors.any? %>><% errors.each do |message| %><span><%= message %></span><% end %></p>
</div>