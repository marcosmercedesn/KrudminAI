<div class="krudmin-ai-table-wrap">
  <table class="krudmin-ai-table">
    <thead><tr><% if resource.bulk_actions.any? %><th scope="col"><span class="krudmin-ai-sr-only"><%= t("krudmin_ai.select_record") %></span></th><% end %><% fields.each do |field| %><% sortable = resource.sortable_attributes.include?(field) %><% direction = params[:sort].to_s.split(":", 2).last if sort_active?(field) %><% aria_sort = direction == "asc" ? "ascending" : direction == "desc" ? "descending" : "none" %><th scope="col" class="krudmin-ai-priority--<%= resource.list_field_priorities.fetch(field, :standard) %>" aria-sort="<%= aria_sort %>"><% if sortable %><%= link_to resource.model_class.human_attribute_name(field), sort_path(field) %><% else %><%= resource.model_class.human_attribute_name(field) %><% end %></th><% end %></tr></thead>
    <tbody>
      <% records.each do |record| %>
        <tr><% if resource.bulk_actions.any? %><td><%= check_box_tag "ids[]", record.id, false, form: "krudmin-ai-bulk-actions", aria: { label: "#{t("krudmin_ai.select_record")}: #{resource_label} #{record.id}" } %></td><% end %><% fields.each_with_index do |field, index| %><td class="krudmin-ai-priority--<%= resource.list_field_priorities.fetch(field, :standard) %>"><% if field_readable?(field, record) %><% adapter = resource.field_adapter(field) %><% belongs_to = adapter.is_a?(KrudminAI::Fields::BelongsTo) %><% value = belongs_to ? adapter.list_value(record, context: krudmin_ai_access_context) : adapter.list_value(record) %><% association_link = belongs_to && adapter.association_link(record, krudmin_ai_access_context) %><% if resource.inline_editable_fields.include?(field) && field_writable?(field, record) %><%= form_with model: record, url: resource_path(record), method: :patch, class: "krudmin-ai-inline-edit" do |form| %><%= adapter.form_control(form, writable: true, errors: [], access_note_id: "#{record.id}-#{field}-inline", **(belongs_to ? { context: krudmin_ai_access_context, authorization_provider: krudmin_ai_authorization_provider } : {})) %><%= form.button t("krudmin_ai.save", resource: resource_label), class: "krudmin-ai-button" %><% end %><% elsif index.zero? %><%= link_to value, resource_path(record) %><% elsif association_link %><%= link_to value, association_link %><% elsif field == :state %><span class="krudmin-ai-status-badge"><%= value %></span><% else %><%= value %><% end %><% end %></td><% end %></tr>
      <% end %>
    </tbody>
  </table>
</div>