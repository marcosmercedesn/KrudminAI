<div class="krudmin-ai-table-wrap">
  <table class="krudmin-ai-table">
    <thead><tr><% if resource.bulk_actions.any? %><th scope="col"><span class="krudmin-ai-sr-only"><%= t("krudmin_ai.select_record") %></span></th><% end %><% fields.each do |field| %><% sortable = resource.sortable_attributes.include?(field) %><% direction = params[:sort].to_s.split(":", 2).last if sort_active?(field) %><% aria_sort = direction == "asc" ? "ascending" : direction == "desc" ? "descending" : "none" %><th scope="col" class="krudmin-ai-priority--<%= resource.list_field_priorities.fetch(field, :standard) %>" aria-sort="<%= aria_sort %>"><% if sortable %><%= link_to resource.model_class.human_attribute_name(field), sort_path(field) %><% else %><%= resource.model_class.human_attribute_name(field) %><% end %></th><% end %></tr></thead>
    <tbody>
      <% records.each do |record| %>
        <tr><% if resource.bulk_actions.any? %><td><%= check_box_tag "ids[]", record.id, false, form: "krudmin-ai-bulk-actions", aria: { label: "#{t("krudmin_ai.select_record")}: #{resource_label} #{record.id}" } %></td><% end %><% fields.each_with_index do |field, index| %><td class="krudmin-ai-priority--<%= resource.list_field_priorities.fetch(field, :standard) %>"><% if field_readable?(field, record) %><% adapter = resource.field_adapter(field) %><% belongs_to = adapter.is_a?(KrudminAI::Fields::BelongsTo) %><% value = belongs_to ? adapter.list_value(record, context: krudmin_ai_access_context) : adapter.list_value(record) %><% association_link = belongs_to && adapter.association_link(record, krudmin_ai_access_context) %><% if resource.inline_editable_fields.include?(field) && field_writable?(field, record) %><%= turbo_frame_tag "#{KrudminAI::ResourceController::INLINE_FRAME_PREFIX}#{record.id}-#{field}" do %><%= form_with model: record, url: resource_path(record), method: :patch, class: "krudmin-ai-inline-edit", data: { controller: "krudmin-ai-form-validation" } do |form| %><%= render "krudmin_ai/ui/field", form: form, field: field, adapter: adapter, writable: true, compact: true, rules: krudmin_ai_validation_rules(field, record), errors: [] %><%= form.button t("krudmin_ai.save", resource: resource_label), class: "krudmin-ai-button" %><% end %><% end %><% elsif index.zero? %><%= link_to resource_path(record) do %><% if adapter.is_a?(KrudminAI::Fields::Boolean) %><%= render "krudmin_ai/ui/boolean_badge", value: value %><% else %><%= value %><% end %><% end %><% elsif association_link %><%= link_to value, association_link %><% elsif adapter.is_a?(KrudminAI::Fields::Boolean) %><%= render "krudmin_ai/ui/boolean_badge", value: value %><% elsif field == :state %><span class="krudmin-ai-status-badge"><%= value %></span><% else %><%= value %><% end %><% end %></td><% end %></tr>
      <% end %>
    </tbody>
  </table>
</div>