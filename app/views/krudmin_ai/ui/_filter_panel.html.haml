- panel_id = local_assigns.fetch(:panel_id, "krudmin-ai-filters")
.krudmin-ai-toolbar{ data: { controller: "krudmin-ai-filter-panel" } }
  = button_tag type: "button", class: "krudmin-ai-button", aria: { controls: panel_id, expanded: "false" }, data: { krudmin_ai_filter_panel_target: "trigger", action: "krudmin-ai-filter-panel#toggle" } do
    Filters
  %section.krudmin-ai-filter-panel{ id: panel_id, hidden: true, aria: { label: "Filters" }, data: { krudmin_ai_filter_panel_target: "panel" } }
    = form_with url: local_assigns.fetch(:url), method: :get, class: "krudmin-ai-filter-grid" do |form|
      = yield form
      .krudmin-ai-form-actions
        = form.submit "Apply filters", class: "krudmin-ai-button krudmin-ai-button--primary"