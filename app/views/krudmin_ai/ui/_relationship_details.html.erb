<% resource.relationships.each_value do |relationship| %>
  <% records = relationship_records(relationship) %>
  <% first_record = records.first %>
  <% fields = first_record ? readable_relationship_display_fields(relationship, first_record) : relationship.display_fields %>
  <% next if fields.empty? %>
  <section class="krudmin-ai-relationship-details" aria-labelledby="<%= relationship.name %>-details-title">
    <h2 id="<%= relationship.name %>-details-title"><%= relationship.label %></h2>
    <% if records.any? %>
      <div class="krudmin-ai-table-wrap">
        <table class="krudmin-ai-table">
          <thead><tr><% fields.each do |field| %><th scope="col"><%= records.klass.human_attribute_name(field) %></th><% end %></tr></thead>
          <tbody><% records.each do |record| %><tr><% fields.each do |field| %><td><% if readable_relationship_display_fields(relationship, record).include?(field) %><%= record.public_send(field).presence || t("krudmin_ai.not_provided") %><% end %></td><% end %></tr><% end %></tbody>
        </table>
      </div>
    <% else %>
      <p class="krudmin-ai-muted"><%= t("krudmin_ai.no_relationship_provided", relationship: relationship.label.downcase) %></p>
    <% end %>
  </section>
<% end %>