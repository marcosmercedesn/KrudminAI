<p class="eyebrow"><%= model.tenant %> / <%= model.state %></p><div class="toolbar"><div><h1><%= model.title %></h1><p class="lede"><%= model.description.presence || "No description supplied." %></p></div><div class="inline-actions"><%= link_to edit_resource_path(model), class: "button" do %><%= krudmin_ai_icon(:pencil) %>Edit<% end %><% if current_user.manager? %><%= button_to resource_path(model), method: :delete, class: "quiet-button danger", form: { data: { turbo_confirm: "Delete this ticket?" } } do %><%= krudmin_ai_icon(:trash_2) %>Delete<% end %><% end %></div></div>
<div class="grid"><div class="metric"><span>State</span><strong><%= model.state %></strong></div><div class="metric"><span>Priority</span><strong><%= model.priority %></strong></div><div class="metric"><span>Assignee</span><strong><%= model.assignee || "-" %></strong></div></div>