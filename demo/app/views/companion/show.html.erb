<p class="eyebrow">Read-only tenant-safe assistant</p><h1>Companion</h1><p class="lede">This local provider receives only the fields explicitly allowlisted by <code>TicketsResource</code>, after tenant and policy scope. It makes no network request and records every exchange as an audit event.</p>
<%= form_with url: companion_path, method: :post, class: "companion-form" do |form| %><label class="field">Ask about the visible ticket workload <%= form.text_area :prompt, required: true, placeholder: "Which ticket should we address first?" %></label><%= form.submit "Ask companion", class: "button" %><% end %>
<% if @result %><section class="panel"><h2>Response</h2><p class="assistant-output"><%= @result.output || @result.errors.map { |error| error[:detail] }.join(" ") %></p><p class="lede">Trace status: <%= @result.status %></p></section><% end %>