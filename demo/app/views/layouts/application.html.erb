<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "KrudminAI Companion" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Demo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "trix", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "krudmin_ai/application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "demo" %>
  </head>

  <body>
    <div class="app-shell">
      <header class="site-header">
        <%= link_to root_path, class: "brand", aria: { label: "KrudminAI home" } do %>
          <span class="brand-mark">K</span><span>Krudmin<span class="brand-accent">AI</span></span>
        <% end %>
        <% if signed_in? %>
          <nav id="primary-navigation" aria-label="Main navigation">
            <%= link_to tickets_path, class: (current_page?(tickets_path) ? "is-active" : nil) do %><%= krudmin_ai_icon(TicketsResource.icon, class: "nav-icon") %>Tickets<% end %>
            <%= link_to assets_path, class: (current_page?(assets_path) ? "is-active" : nil) do %><%= krudmin_ai_icon(AssetsResource.icon, class: "nav-icon") %>Assets<% end %>
            <%= link_to locations_path, class: (current_page?(locations_path) ? "is-active" : nil) do %><%= krudmin_ai_icon(LocationsResource.icon, class: "nav-icon") %>Locations<% end %>
            <%= link_to vendors_path, class: (current_page?(vendors_path) ? "is-active" : nil) do %><%= krudmin_ai_icon(VendorsResource.icon, class: "nav-icon") %>Vendors<% end %>
            <%= link_to dashboard_path, class: (current_page?(dashboard_path) ? "is-active" : nil) do %><%= krudmin_ai_icon(:layout_dashboard, class: "nav-icon") %>Dashboard<% end %>
            <%= link_to companion_path, class: (current_page?(companion_path) ? "is-active" : nil) do %><%= krudmin_ai_icon(:sparkles, class: "nav-icon") %>Companion<% end %>
          </nav>
          <div class="sidebar-footer">
            <div class="identity"><strong><%= current_user.name %></strong><span><%= current_tenant %> / <%= current_user.roles.join(", ") %></span></div>
            <%= button_to "Sign out", session_path, method: :delete, class: "quiet-button" %>
          </div>
        <% end %>
      </header>
      <button class="sidebar-backdrop" type="button" aria-label="Close navigation" data-sidebar-backdrop></button>
      <main class="page-shell">
        <% if signed_in? %>
          <div class="workspace-bar">
            <button class="nav-toggle" type="button" aria-controls="primary-navigation" aria-expanded="true" data-sidebar-toggle>
              <%= krudmin_ai_icon(:panel_left_close, class: "nav-toggle-icon nav-toggle-icon--collapse") %>
              <%= krudmin_ai_icon(:menu, class: "nav-toggle-icon nav-toggle-icon--open") %>
              <span class="sr-only" data-sidebar-toggle-label>Collapse navigation</span>
            </button>
            <p><span class="workspace-indicator"></span><%= current_tenant %> workspace</p>
            <label class="theme-picker">
              <span>Appearance</span>
              <select aria-label="Appearance" data-theme-select>
                <option value="system">System</option>
                <option value="light">Light</option>
                <option value="dark">Dark</option>
              </select>
            </label>
          </div>
        <% end %>
        <div id="krudmin-ai-flash">
          <% if flash[:notice] %><p class="notice" role="status"><%= flash[:notice] %></p><% end %>
          <% if flash[:alert] %><p class="alert" role="alert"><%= flash[:alert] %></p><% end %>
        </div>
        <%= render "krudmin_ai/ui/breadcrumbs" if respond_to?(:krudmin_ai_breadcrumbs) %>
        <%= yield %>
      </main>
    </div>
    <script>
      (() => {
        const collapsedKey = "krudmin-ai-sidebar-collapsed";
        const root = document.documentElement;
        const controls = document.querySelectorAll("[data-sidebar-toggle]");
        const backdrop = document.querySelector("[data-sidebar-backdrop]");
        const mobileQuery = window.matchMedia("(max-width: 70rem)");
        const mobile = () => mobileQuery.matches;
        const closeMobileNavigation = () => { delete root.dataset.sidebarOpen; sync(); };
        const sync = () => {
          const expanded = mobile() ? root.dataset.sidebarOpen === "true" : root.dataset.sidebarCollapsed !== "true";
          controls.forEach((control) => {
            control.setAttribute("aria-expanded", String(expanded));
            control.querySelector("[data-sidebar-toggle-label]").textContent = expanded ? "Collapse navigation" : "Open navigation";
          });
        };
        const restore = () => {
          if (mobile()) {
            delete root.dataset.sidebarCollapsed;
            delete root.dataset.sidebarOpen;
          } else {
            root.dataset.sidebarCollapsed = localStorage.getItem(collapsedKey) === "true" ? "true" : "false";
            delete root.dataset.sidebarOpen;
          }
          sync();
        };
        controls.forEach((control) => control.addEventListener("click", () => {
          if (mobile()) {
            root.dataset.sidebarOpen = root.dataset.sidebarOpen === "true" ? "false" : "true";
          } else {
            const collapsed = root.dataset.sidebarCollapsed !== "true";
            root.dataset.sidebarCollapsed = String(collapsed);
            localStorage.setItem(collapsedKey, String(collapsed));
          }
          sync();
        }));
        backdrop?.addEventListener("click", closeMobileNavigation);
        document.addEventListener("keydown", (event) => { if (event.key === "Escape" && mobile()) closeMobileNavigation(); });
        document.querySelectorAll("#primary-navigation a").forEach((link) => link.addEventListener("click", () => { if (mobile()) closeMobileNavigation(); }));
        mobileQuery.addEventListener("change", restore);
        restore();
      })();
      (() => {
        const select = document.querySelector("[data-theme-select]");
        if (!select) return;
        const key = "krudmin-ai-theme";
        const apply = (mode) => {
          const theme = mode === "system" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : mode;
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.themeMode = mode;
        };
        select.value = localStorage.getItem(key) || "system";
        apply(select.value);
        select.addEventListener("change", () => { localStorage.setItem(key, select.value); apply(select.value); });
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { if (select.value === "system") apply("system"); });
      })();
    </script>
  </body>
</html>
