<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "KrudminAI Companion" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Demo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to "KrudminAI", root_path, class: "brand" %>
      <% if signed_in? %>
        <nav aria-label="Main navigation">
          <%= link_to "Tickets", tickets_path %>
          <%= link_to "Dashboard", dashboard_path %>
          <%= link_to "Companion", companion_path %>
        </nav>
        <div class="identity"><strong><%= current_user.name %></strong><span><%= current_tenant %> / <%= current_user.roles.join(", ") %></span></div>
        <%= button_to "Sign out", session_path, method: :delete, class: "quiet-button" %>
      <% end %>
    </header>
    <main class="page-shell">
      <% if flash[:notice] %><p class="notice" role="status"><%= flash[:notice] %></p><% end %>
      <% if flash[:alert] %><p class="alert" role="alert"><%= flash[:alert] %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
