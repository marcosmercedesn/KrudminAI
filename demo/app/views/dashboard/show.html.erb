<p class="eyebrow">Policy-aware dashboard</p><h1>Workspace overview</h1><p class="lede">Counts and recent records are derived from the same tenant- and policy-scoped relation as the resource list.</p>
<div class="grid"><div class="metric"><span>Visible tickets</span><strong><%= @tickets.count %></strong></div><div class="metric"><span>Open</span><strong><%= @open_count %></strong></div><div class="metric"><span>Assigned</span><strong><%= @assigned_count %></strong></div></div>
<section class="panel"><h2>Recent tickets</h2><ul><% @recent_tickets.each do |ticket| %><li><%= link_to ticket.title, ticket_path(ticket) %> <span class="badge state-<%= ticket.state %>"><%= ticket.state %></span></li><% end %></ul></section>
<section class="panel"><h2>Recent audit activity</h2><ul><% @audit_events.each do |event| %><li><strong><%= event.operation.presence || event.event_type %></strong> by <%= event.actor_name %> at <%= event.created_at.strftime("%H:%M") %></li><% end %><% if @audit_events.empty? %><li>No activity has been recorded for this tenant.</li><% end %></ul></section>