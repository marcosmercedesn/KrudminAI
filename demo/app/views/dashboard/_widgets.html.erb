<div class="metric-grid">
  <% widgets.reject { |widget| widget.rows.any? }.each do |widget| %>
    <section class="metric-card metric-card--<%= widget.color %> dashboard-widget--<%= widget.name %>">
      <div class="metric-card-header"><p><%= widget.label %></p><span class="metric-icon metric-icon--<%= widget.color %>"><%= krudmin_ai_icon(widget.icon || widget.resource.icon) %></span></div>
      <% if widget.state == :loading %><strong aria-live="polite">Loading</strong><% elsif widget.state == :error %><strong role="alert">Unavailable</strong><% elsif widget.state == :empty %><strong>0</strong><% else %><strong><%= widget.value %></strong><% end %>
      <% unless widget.drill_down_params.empty? %><%= link_to "View records", public_send("#{widget.resource.route_key}_path", widget.drill_down_params), class: "text-action" %><% end %>
    </section>
  <% end %>
</div>
<% widgets.select { |widget| widget.rows.any? || widget.state == :empty && widget.columns.any? }.each do |widget| %>
  <section class="panel panel--flush dashboard-widget--<%= widget.name %>">
    <header class="panel-header"><div><h2><%= widget.label %></h2></div><%= link_to "View records", public_send("#{widget.resource.route_key}_path", widget.drill_down_params), class: "text-action" %></header>
    <% if widget.state == :empty %><p class="empty-state">No records are available.</p><% else %>
      <div class="krudmin-ai-table-wrap"><table class="krudmin-ai-table"><thead><tr><% widget.columns.each do |field| %><th scope="col"><%= widget.resource.model_class.human_attribute_name(field) %></th><% end %></tr></thead><tbody><% widget.rows.each do |row| %><tr><% widget.columns.each do |field| %><td><%= row[field] %></td><% end %></tr><% end %></tbody></table></div>
    <% end %>
  </section>
<% end %>