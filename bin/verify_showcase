#!/usr/bin/env ruby

require "json"
require "fileutils"
require "rbconfig"
require "tmpdir"

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"))
require "krudmin_ai/version"
manifest = JSON.parse(File.read(File.join(root, "templates/showcase/manifest.json")))
registry = JSON.parse(File.read(File.join(root, "docs/capability_registry.json")))
available_capabilities = registry.fetch("capabilities").map { |capability| capability.fetch("name") }
missing_capabilities = manifest.fetch("required_capabilities") - available_capabilities
abort "Showcase requires unregistered capabilities: #{missing_capabilities.join(', ')}" if missing_capabilities.any?

missing_documents = manifest.fetch("required_documents").reject { |path| File.file?(File.join(root, path)) }
abort "Showcase documentation is missing: #{missing_documents.join(', ')}" if missing_documents.any?

required_demonstrations = %w[crud search_and_filtering tenant_and_role_access custom_actions state_transitions dashboard_summaries audit_trail_hooks themes]
missing_demonstrations = required_demonstrations - manifest.fetch("demonstrations").keys
abort "Showcase demonstrations are missing: #{missing_demonstrations.join(', ')}" if missing_demonstrations.any?

puts "Showcase conformance OK"

if ARGV.first == "--host"
	host = File.expand_path(ARGV.fetch(1, "demo"), root)
	abort "Showcase host does not exist: #{host}" unless File.directory?(host)

	Dir.mktmpdir("krudmin_ai_showcase") do |destination|
		FileUtils.cp_r("#{host}/.", destination)
		gemfile = File.join(destination, "Gemfile")
		contents = File.read(gemfile)
		abort "Showcase host must use a local KrudminAI path dependency" unless contents.sub!("path: \"..\"", "path: \"#{root}\"")

		File.write(gemfile, contents)
		rails = [RbConfig.ruby, "-S", "bundle", "exec", "bin/rails"]
		run = ->(*arguments) { abort "Showcase host command failed: #{arguments.join(' ')}" unless system(*arguments, chdir: destination) }

		run.call(*rails, "generate", "krudmin_ai:showcase", "--mode", "full")
		run.call(*rails, "generate", "krudmin_ai:showcase", "--mode", "full")
		run.call(*rails, "db:migrate")
		run.call(*rails, "runner", "load Rails.root.join(\"db/seeds/krudmin_ai_showcase.rb\")")
		run.call(*rails, "test", "test/integration/krudmin_ai_showcase_test.rb")
		run.call(*rails, "runner", "puts Rails.application.routes.url_helpers.admin_showcase_tickets_path")

		routes = File.read(File.join(destination, "config/routes.rb"))
		abort "Showcase route was duplicated" unless routes.scan("resources :showcase_tickets").length == 1

		installed_manifest = JSON.parse(File.read(File.join(destination, ".krudmin_ai/showcase_manifest.json")))
		abort "Showcase mode is not full" unless installed_manifest.fetch("mode") == "full"
		abort "Showcase version is not locked to the engine" unless installed_manifest.fetch("engine_version") == KrudminAI::VERSION
	end

	puts "Showcase host conformance OK"
end