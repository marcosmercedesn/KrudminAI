        ).call(record: widget, field: :masked_id)
        assert_equal :forbidden, denied_reveal.outcome
        assert_equal audit_events_before_reveal, KrudminAI.config.audit_provider.events.length
        assert_not_includes response.body, "SENSITIVE-42"

        get new_admin_widget_path
        assert_response :success
        assert_select "input[type='text'][name='widget[title]']"
        assert_select "fieldset.krudmin-ai-form-section legend", text: "Identity"
        assert_select "fieldset.krudmin-ai-form-section--two legend", text: "Details"
        assert_select "input[type='text'][name='widget[summary]']"
        assert_select "textarea[name='widget[description]']"
