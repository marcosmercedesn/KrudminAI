        assert_select "option", text: "Cross tenant team", count: 0
        assert_select "input[type='search'][value='']"
        assert_select "option", text: "Cross tenant", count: 0
        assert_select "option", text: "Policy denied", count: 0
        assert_select "option", text: "Restricted recruiter", count: 0
        assert_select "trix-editor"
        assert_select "input[type='file'][name='widget[avatar]']"
        assert_select "input[type='file'][name='widget[attachment]']"

        get lookup_field_admin_widgets_path(field_name: :remote_recruiter_id), params: { q: "Remote recruiter" }
        assert_response :success
        lookup_payload = JSON.parse(response.body)
        assert_equal 5, lookup_payload.fetch("results").length
        assert_equal true, lookup_payload.fetch("more")
        assert_not_includes lookup_payload.fetch("results").map { |result| result.fetch("label") }, "Remote recruiter cross tenant"

        get lookup_field_admin_widgets_path(field_name: :remote_recruiter_id), params: { q: "R" }
        assert_response :success
        assert_equal [], JSON.parse(response.body).fetch("results")

        get admin_widget_path(widget)
        assert_response :success
        assert_includes response.body, widget.title
        assert_includes response.body, widget.summary
        assert_includes response.body, "A detailed description"
        assert_includes response.body, "09:05"
        assert_includes response.body, '{&quot;source&quot;:&quot;generated-host&quot;}'
        assert_includes response.body, "Rich private notes"
        assert_includes response.body, "Widget: Declared title"
        assert_select "a[href='/admin/ranks/\#{rank.id}']", text: "Regional"
        assert_select "img.krudmin-ai-record-image[alt='Avatar']"
        assert_select "a", text: "resume.pdf"
        assert_not_includes response.body, "do-not-disclose"
        assert_not_includes response.body, "hidden-token"
        assert_not_includes response.body, "INT-0099"

        draft_widget = Widget.create!(tenant: "north", title: "Draft action", summary: "Action", state: "draft")
        get admin_widget_path(draft_widget)
        assert_response :success
        assert_select "form[action='\#{action_admin_widget_path(draft_widget, action_name: :publish)}'] button", text: "Publish"
        post action_admin_widget_path(draft_widget, action_name: :publish)
        assert_response :see_other
        assert_equal "published", draft_widget.reload.state
        post action_admin_widget_path(draft_widget, action_name: :publish)
        assert_response :unprocessable_entity

        bulk_one = Widget.create!(tenant: "north", title: "Bulk one", summary: "Action", state: "draft")
        bulk_two = Widget.create!(tenant: "north", title: "Bulk two", summary: "Action", state: "draft")
        post bulk_action_admin_widgets_path(action_name: :publish), params: { ids: [bulk_one.id, bulk_two.id] }
        assert_response :see_other
        assert_equal %w[published published], [bulk_one.reload.state, bulk_two.reload.state]
        audit_events_before_cross_tenant_bulk = KrudminAI.config.audit_provider.events.length
        cross_tenant_widget = Widget.create!(tenant: "south", title: "Cross tenant bulk", summary: "Excluded", state: "draft")
        post bulk_action_admin_widgets_path(action_name: :publish), params: { ids: [bulk_one.id, cross_tenant_widget.id] }
        assert_response :forbidden
        assert_equal audit_events_before_cross_tenant_bulk, KrudminAI.config.audit_provider.events.length
        assert_equal "draft", cross_tenant_widget.reload.state

        get edit_admin_widget_path(widget)
        assert_response :success
        assert_select "input[type='search'][value='Remote recruiter 0']"
        assert_select "input[name='widget[insurance_attributes][provider]']"
        assert_select "select[name='widget[insurance_attributes][rank_id]'] option", text: "Regional"
        assert_select "button", text: "Add Passenger"

        patch admin_widget_path(widget), params: { widget: { insurance_attributes: { provider: "North cover", rank_id: rank.id } } }
        assert_response :see_other
        assert_equal "North cover", widget.reload.insurance.provider
        assert_equal rank.id, widget.insurance.rank_id

        audit_events_before_nested_rank_forgery = KrudminAI.config.audit_provider.events.length
        patch admin_widget_path(widget), params: { widget: { insurance_attributes: { id: widget.insurance.id, provider: "North cover", rank_id: cross_tenant_rank.id } } }
        assert_response :forbidden
        assert_equal rank.id, widget.reload.insurance.rank_id
        assert_equal audit_events_before_nested_rank_forgery, KrudminAI.config.audit_provider.events.length

        other_widget = Widget.create!(tenant: "south", title: "Other", summary: "Other summary")
        foreign_insurance = Insurance.create!(widget: other_widget, tenant: "south", provider: "South cover")
        audit_events_before_insurance_forgery = KrudminAI.config.audit_provider.events.length
        patch admin_widget_path(widget), params: { widget: { insurance_attributes: { id: foreign_insurance.id, provider: "Forged" } } }
        assert_response :forbidden
        assert_equal "North cover", widget.reload.insurance.provider
        assert_equal audit_events_before_insurance_forgery, KrudminAI.config.audit_provider.events.length

        patch admin_widget_path(widget), params: { widget: { insurance_attributes: { id: widget.insurance.id, _destroy: "1" } } }
        assert_response :see_other
        assert_nil widget.reload.insurance

        patch admin_widget_path(widget), params: { widget: { team_ids: [north_team.id] } }
        assert_response :see_other
        assert_equal [north_team.id], widget.reload.team_ids

        audit_events_before_team_forgery = KrudminAI.config.audit_provider.events.length
        patch admin_widget_path(widget), params: { widget: { team_ids: [south_team.id] } }
        assert_response :forbidden
        assert_equal [north_team.id], widget.reload.team_ids
        assert_equal audit_events_before_team_forgery, KrudminAI.config.audit_provider.events.length

        patch admin_widget_path(widget), params: { widget: { passengers_attributes: { "0" => { name: "Passenger" } } } }
        assert_response :see_other
        passenger = widget.reload.passengers.sole

        audit_events_before_passenger_validation = KrudminAI.config.audit_provider.events.length
        patch admin_widget_path(widget), params: { widget: { passengers_attributes: { "0" => { name: "" } } } }
        assert_response :unprocessable_entity
        assert_includes response.body, "Name can&#39;t be blank"
        assert_equal audit_events_before_passenger_validation, KrudminAI.config.audit_provider.events.length

        patch admin_widget_path(widget), params: { widget: { passengers_attributes: { "0" => { id: passenger.id, secret: "forged" } } } }
        assert_response :forbidden
        assert_nil passenger.reload.secret

        foreign_passenger = Passenger.create!(widget: other_widget, tenant: "south", name: "Foreign passenger")
        audit_events_before_passenger_forgery = KrudminAI.config.audit_provider.events.length
        patch admin_widget_path(widget), params: { widget: { passengers_attributes: { "0" => { id: foreign_passenger.id, name: "Forged" } } } }
        assert_response :forbidden
        assert_equal audit_events_before_passenger_forgery, KrudminAI.config.audit_provider.events.length

        patch admin_widget_path(widget), params: { widget: { passengers_attributes: { "0" => { id: passenger.id, _destroy: "1" } } } }
        assert_response :see_other
        assert_empty widget.reload.passengers

        csv = KrudminAI::DataOperations::Exporter.new(
          resource: WidgetsResource,
          context: KrudminAI::AccessContext.new(actor: Object.new, tenant: "north", roles: []),
          auditor: KrudminAI.config.audit_provider
        ).call(profile: :scalar_csv, relation: Widget.where(id: widget.id)).csv
        row = CSV.parse(csv, headers: true).first
        assert_equal "EUR 12.50", row["amount"]
        assert_equal "15.5%", row["discount"]
        assert_equal "REF-0042", row["reference_number"]
        assert_not_includes csv, "do-not-disclose"
        assert_not_includes csv, "hidden-token"
        assert_not_includes csv, "SENSITIVE-42"

        ai_context = KrudminAI::Ai::ContextBuilder.new(
          resource: WidgetsResource,
          context: KrudminAI::AccessContext.new(actor: Object.new, tenant: "north", roles: [])
        ).build(Widget.where(id: widget.id)).records.first
        assert_equal({ "source" => "generated-host" }, ai_context[:metadata])
        assert_equal "EUR 12.50", ai_context[:amount]
        assert_nil ai_context[:password]
        assert_nil ai_context[:token]
        assert_nil ai_context[:masked_id]
        assert_nil WidgetsResource.field_adapter(:masked_id).json_value(widget)

        post admin_widgets_path(format: :json), params: {
          widget: { title: "JSON widget", summary: "JSON summary", amount: "20.00", state: "draft", password: "another-secret", token: "another-token" }
        }
        assert_response :created
        payload = JSON.parse(response.body)
        assert_equal "20.0", payload.dig("data", "amount").to_s
        assert_nil payload.dig("data", "password")
        assert_nil payload.dig("data", "token")

        assert_no_difference("Widget.count") do
          post admin_widgets_path(format: :json), params: {
            widget: { title: "Denied widget", summary: "Denied summary", internal_code: "100" }
          }
        end
        assert_response :forbidden

        audit_events_before_forgery = KrudminAI.config.audit_provider.events.length
        patch admin_widget_path(widget, format: :json), params: { widget: { rank_id: cross_tenant_rank.id } }
        assert_response :forbidden
        assert_equal rank.id, widget.reload.rank_id
        assert_equal audit_events_before_forgery, KrudminAI.config.audit_provider.events.length
      end

      test "generated resource renders generic controls in Spanish" do
        Widget.create!(tenant: "north", title: "Miembro visible", summary: "Cobertura localizada", state: "draft")

        # The request resets the locale, so the default is switched rather than wrapped.
        original_locale = I18n.default_locale
        I18n.default_locale = :es
        get admin_widgets_path

        assert_response :success
        assert_select "a", text: "Nuevo Widget"
        assert_select "button", text: "Aplicar filtros"
        assert_select "a", text: "Restablecer"
        assert_select "nav[aria-label='Paginación']"
      ensure
        I18n.default_locale = original_locale
      end
    end
  RUBY

  write_file(host, "test/system/resource_accessibility_test.rb", <<~RUBY)
    require "application_system_test_case"

    class ResourceAccessibilityTest < ApplicationSystemTestCase
      setup do
        Widget.create!(tenant: "north", title: "Miembro visible", summary: "Interfaz accesible", state: "draft")
        @original_locale = I18n.default_locale
        I18n.default_locale = :es
      end

      teardown { I18n.default_locale = @original_locale }

      test "generated resource remains accessible across supported viewports in Spanish" do
        [[1440, 900], [768, 1024], [390, 844]].each do |width, height|
          page.current_window.resize_to(width, height)
          visit admin_widgets_path

          assert_selector "main"
          assert_selector "h1"
          assert_selector "nav[aria-label='Paginación']"
          click_button "Filtros"
          assert_selector "button", text: "Aplicar filtros"
          assert page.evaluate_script("document.documentElement.scrollWidth <= window.innerWidth"), "Expected no horizontal overflow at \#{width}px"
          assert page.evaluate_script(<<~JAVASCRIPT), "Expected every visible control to have an accessible name at \#{width}px"
            [...document.querySelectorAll("button, input:not([type=hidden]), select, textarea")]
              .filter((control) => control.offsetParent !== null)
              .every((control) => control.labels.length > 0 || control.getAttribute("aria-label") || control.getAttribute("aria-labelledby") || control.innerText.trim() || control.value)
          JAVASCRIPT

          focus_target = page.first("a, button, input, select, textarea")
          page.execute_script("arguments[0].focus()", focus_target)
          assert page.evaluate_script("document.activeElement === arguments[0]", focus_target)
          assert_operator page.evaluate_script("parseFloat(getComputedStyle(document.activeElement).outlineWidth)"), :>, 0
        end
      end
    end
  RUBY

  run.call(*rails, "db:migrate")
  run.call(*rails, "test", "test/integration/field_adapters_test.rb")
  run.call(*rails, "test:system", "test/system/resource_accessibility_test.rb")
end

puts "Generated field-adapter host conformance OK"
